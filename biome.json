{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": [
      "design_extracted/**/*",
      "design_temp",
      "design_temp_fresh.gz",
      "dist/**/*",
      "node_modules/**/*",
      "public/**/*",
      "*.log",
      "routeTree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noDefaultExport": "off",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useNumberNamespace": "error"
      },
      "complexity": {
        "noForEach": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        }
      },
      "suspicious": {
        "noAssignInExpressions": "error",
        "noImplicitAnyLet": "error",
        "noRedeclare": "error",
        "noArrayIndexKey": "off",
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        },
        "noEmptyBlockStatements": "error",
        "noEvolvingTypes": "error"
      },
      "a11y": {
        "noLabelWithoutControl": "error",
        "useValidAnchor": "error",
        "useKeyWithClickEvents": "error",
        "useSemanticElements": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "options": {
            "attributes": ["className", "classList"],
            "functions": ["clsx", "cva", "cn"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "include": ["src/features/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@features/llm": "Features must not import other feature internals. Move shared logic to @shared or consume an explicit public contract.",
                  "@features/explorer-core": "Features must not import other feature internals. Move shared logic to @shared or consume an explicit public contract.",
                  "@features/infrastructure": "Features must not import other feature internals. Move shared logic to @shared or consume an explicit public contract.",
                  "@features/log": "Features must not import other feature internals. Move shared logic to @shared or consume an explicit public contract.",
                  "@features/metrics": "Features must not import other feature internals. Move shared logic to @shared or consume an explicit public contract.",
                  "@features/overview": "Features must not import other feature internals. Move shared logic to @shared or consume an explicit public contract.",
                  "@features/settings": "Features must not import other feature internals. Move shared logic to @shared or consume an explicit public contract.",
                  "@features/traces": "Features must not import other feature internals. Move shared logic to @shared or consume an explicit public contract."
                }
              }
            }
          }
        }
      }
    },
    {
      "include": ["vite.config.ts", "scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
